<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI для установки на все компьютеры организации (GPO, Intune, SCCM):
    msiexec /i UzbekHarflari-<версия>-x64.msi /qn
  Собирается wixl (msitools) — см. Makefile. UpgradeCode не менять: по нему новая версия
  заменяет старую.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="O'zbek harflari" Language="1033" Version="$(var.Version)"
           Manufacturer="O'zbek harflari" UpgradeCode="9910AE71-D09D-4699-B608-44A1B3EA36A2">
    <!-- Платформу задаёт wixl -a x64. Строки MSI — только ASCII (кодовая страница не задана). -->
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="O'zbek harflari - new Uzbek Latin letters as you type"
             Comments="https://github.com/SAIDAKBAR123/uzbek_alphabet" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of O'zbek harflari is already installed." />
    <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />

    <Icon Id="app.ico" SourceFile="$(var.BuildDir)/app.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/SAIDAKBAR123/uzbek_alphabet" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="UzbekHarflari">
          <Component Id="App" Guid="79141399-E8AE-477D-A760-3015060CF7B5" Win64="yes">
            <File Id="AppExe" Name="UzbekHarflari.exe" Source="$(var.BuildDir)/UzbekHarflari.exe" KeyPath="yes" />
            <!-- Автозапуск для всех пользователей. Отключить у себя: Параметры → Приложения → Автозагрузка. -->
            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                           Name="UzbekHarflari" Type="string" Value="&quot;[INSTALLDIR]UzbekHarflari.exe&quot;" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="Shortcut" Guid="1427A9AB-E955-485B-9C1F-CE70C549FC19" Win64="yes">
          <Shortcut Id="AppShortcut" Name="O'zbek harflari" Target="[INSTALLDIR]UzbekHarflari.exe"
                    WorkingDirectory="INSTALLDIR" Icon="app.ico" />
          <RegistryValue Root="HKLM" Key="Software\UzbekHarflari" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="O'zbek harflari" Level="1">
      <ComponentRef Id="App" />
      <ComponentRef Id="Shortcut" />
    </Feature>
  </Product>
</Wix>
